# ---------------------------------------------------------------------------
# Seller identity (Impressum) – REQUIRED by ZET / ZZP. Shown in footer, legal
# pages, withdrawal form and structured data. Unset values render as
# "[UPISATI ...]" placeholders on the site – fill ALL of them before launch.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://astera.com
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_LEGAL_FORM=          # e.g. d.o.o. / j.d.o.o. / obrt (optional)
NEXT_PUBLIC_COMPANY_STREET=
NEXT_PUBLIC_COMPANY_POSTAL_CODE=
NEXT_PUBLIC_COMPANY_CITY=
NEXT_PUBLIC_COMPANY_OIB=
NEXT_PUBLIC_COMPANY_REGISTRATION_LABEL=MBS   # MBS (d.o.o.) or MBO (obrt)
NEXT_PUBLIC_COMPANY_REGISTRATION_NUMBER=
NEXT_PUBLIC_COMPANY_COURT=               # e.g. "Trgovački sud u Zagrebu" (d.o.o. only)
NEXT_PUBLIC_COMPANY_SHARE_CAPITAL=       # e.g. "2.500,00 EUR" (d.o.o. only)
NEXT_PUBLIC_COMPANY_IBAN=HR
NEXT_PUBLIC_COMPANY_BANK=
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_COMPANY_PHONE=+385 95 579 1294
NEXT_PUBLIC_COMPANY_OWNER=               # director / owner full name
NEXT_PUBLIC_COMPANY_LAT=                 # workshop/store coordinates (LocalBusiness schema)
NEXT_PUBLIC_COMPANY_LNG=
NEXT_PUBLIC_SOCIAL_URLS=                 # comma-separated profile URLs (schema sameAs)

# "in_system" => "PDV uračunat u cijenu"; "exempt" => small-business exemption notice (čl. 90. Zakona o PDV-u)
NEXT_PUBLIC_VAT_STATUS=in_system

# ---------------------------------------------------------------------------
# Optional third-party trackers. They are loaded ONLY after the visitor opts in
# via the cookie banner (see src/components/ConsentScripts.tsx).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=                       # e.g. G-XXXXXXXXXX  (analytics consent)
NEXT_PUBLIC_META_PIXEL_ID=               # numeric ID         (marketing consent)